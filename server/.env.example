# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database
MONGO_URI=mongodb://127.0.0.1:27017/collabnote

# Auth
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
JWT_REFRESH_EXPIRES_IN=30d
COOKIE_SECRET=replace_with_another_long_random_secret

# Redis (Socket.IO adapter, caching, rate-limit store)
REDIS_URL=redis://127.0.0.1:6379

# Cloudinary (avatars, attachments)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (Nodemailer SMTP — verification / password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CollabNote <no-reply@collabnote.app>"

# AI provider (used by AI service layer — summary, rewrite, translate, etc.)
# Supported: "anthropic" (model e.g. claude-sonnet-5) or "gemini" (model e.g. gemini-flash-lite-latest)
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-flash-lite-latest

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
